# =============================================================================
# AGROLINK - variaveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA comite o arquivo ".env" (ele ja esta no .gitignore).
# =============================================================================

# --- Aplicacao --------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_ID=agrolink
APP_URL=http://localhost:3000

# --- Banco de dados (Supabase / PostgreSQL) ---------------------------------
# Supabase -> Settings -> Database -> Connection string -> URI (PostgreSQL)
# Formato: postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# Observacoes:
# - Use a URL direta (porta 5432) para migracoes (drizzle-kit) e o *pooler de
#   transacoes* (porta 6543) para a aplicacao em producao.
# - O driver detecta o pooler pela porta 6543 (ou por ?pgbouncer=true) e desliga
#   prepared statements automaticamente, exigido pelo pooler do Supabase.
# - O TLS e definido pelo parametro ?sslmode=require na propria URL.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/agrolink

# --- Autenticacao -----------------------------------------------------------
# Segredo usado para assinar o cookie de sessao (JWT HS256).
# Gere um valor aleatorio forte, por exemplo: openssl rand -base64 32
SESSION_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
# JWT_SECRET tambem e aceito como alias de SESSION_SECRET.
JWT_SECRET=

# "true" exige HTTPS no cookie de sessao. Em desenvolvimento local (http://localhost)
# deixe como "false"; em producao use "true".
COOKIE_SECURE=false

# E-mails (separados por virgula) que recebem o papel de administrador no primeiro
# acesso, mesmo que ja existam usuarios administradores.
ADMIN_EMAILS=

# --- Integracoes opcionais --------------------------------------------------
# Google Maps (usado apenas se o mapa for habilitado no cliente)
VITE_GOOGLE_MAPS_API_KEY=

# Armazenamento de arquivos (S3 ou compativel)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
